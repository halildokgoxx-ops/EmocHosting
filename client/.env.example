# Client Firebase Configuration (Vite)
# Mode: "cloud" or "emulator"
VITE_FIREBASE_MODE=cloud
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Local Firebase Emulator settings (used when VITE_FIREBASE_MODE=emulator)
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT=8080

# Backend API URL (leave empty in dev to use Vite proxy)
VITE_API_URL=
VITE_ADMIN_PATH=/komuta-x9k4
VITE_ADMIN_API_PATH=/api/komuta-x9k4
