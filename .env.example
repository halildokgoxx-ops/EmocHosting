# ==========================================
# EmoçHosting Environment Configuration
# ==========================================

# Server Settings
PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_HOST=localhost
DOMAIN_SUFFIX=emochost.com
OWNER_ADMIN_EMAIL=halildokgoxx@gmail.com
ADMIN_PATH=/komuta-x9k4
TRUST_PROXY=false

# Firebase Mode: "cloud" or "emulator"
FIREBASE_MODE=cloud
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# Optional: Path to Firebase Admin SDK serviceAccountKey.json (relative to server/ or absolute)
# Or provide FIREBASE_CLIENT_EMAIL and FIREBASE_PRIVATE_KEY directly
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Port Range Allocated for Real Hosted Servers (25565 reserved for EmoçHosting Domain Router)
MC_PROXY_PORT=25565
ALLOC_PORT_START=25566
ALLOC_PORT_END=26500
WEB_PORT_START=8100
WEB_PORT_END=8999
SFTP_PORT=2022

# Java Binary Path (for real Minecraft servers; defaults to 'java' in PATH)
# Windows Android Studio JBR example: C:\Program Files\Android\Android Studio\jbr\bin\java.exe
JAVA_PATH=java
NODE_PATH=node
PYTHON_PATH=python
